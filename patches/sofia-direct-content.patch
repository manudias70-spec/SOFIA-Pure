+{
+	unsigned char type;
+	short info;
+	std::string text;
+};
+
 enum { DBPS_OSD_WIDTH = 640, DBPS_OSD_HEIGHT = 480 };
 extern int DBPS_SaveSlotIndex;
 extern std::string DBPS_BrowsePath;
