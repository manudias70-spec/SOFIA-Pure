+// Read-only bridge to Pure's mounted DOS filesystems. The request is dispatched
+// through the same emulation-thread callback used by DBPS_OpenContent, so
+// DriveFileIterator never touches DOS's DTA from the frontend drawing code.
+static std::vector<DBPS_DriveDirectoryEntry> dbps_drive_directory;
+static std::string dbps_drive_scan_path;
+static unsigned dbps_drive_scan_drive;
+static bool dbps_drive_scan_pending;
+
+static void DBPS_DriveDirectoryCollect(const char* path, bool is_dir, Bit32u size,
+	Bit16u, Bit16u, Bit8u, Bitu data)
+{
+	std::vector<DBPS_DriveDirectoryEntry>* entries =
+		(std::vector<DBPS_DriveDirectoryEntry>*)data;
+	DBPS_DriveDirectoryEntry entry;
+	entry.name.assign(path);
+	entry.isDirectory = is_dir;
+	entry.size = size;
+	entries->push_back(entry);
+}
+
+static void DBPS_DriveDirectoryDo()
+{
+	std::vector<DBPS_DriveDirectoryEntry> entries;
+	if (dbps_drive_scan_drive < DOS_DRIVES && Drives[dbps_drive_scan_drive])
+		DriveFileIterator(Drives[dbps_drive_scan_drive], DBPS_DriveDirectoryCollect,
+			(Bitu)&entries, 1, dbps_drive_scan_path.c_str());
+	dbps_drive_directory.swap(entries);
+	dbps_drive_scan_pending = false;
+}
+
+bool DBPS_RequestDriveDirectory(unsigned drive, const char* path)
+{
+	// Do not replace another operation already queued for the emulation thread.
+	if (dbps_emu_thread_func || dbps_drive_scan_pending || drive >= DOS_DRIVES)
+		return false;
+	dbps_drive_scan_drive = drive;
+	dbps_drive_scan_path.assign(path ? path : "");
+	dbps_drive_directory.clear();
+	dbps_drive_scan_pending = true;
+	dbps_emu_thread_func = DBPS_DriveDirectoryDo;
+	return true;
+}
+
+bool DBPS_IsDriveDirectoryScanPending() { return dbps_drive_scan_pending; }
+size_t DBPS_GetDriveDirectoryCount() { return dbps_drive_directory.size(); }
+bool DBPS_GetDriveDirectoryEntry(size_t index, DBPS_DriveDirectoryEntry& out)
+{
+	if (index >= dbps_drive_directory.size()) return false;
+	out = dbps_drive_directory[index];
+	return true;
+}
+
 void DBPS_AddDisc(const char* path)
 {
