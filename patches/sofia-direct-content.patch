diff --git a/dosbox_pure_osd.h b/dosbox_pure_osd.h
--- a/dosbox_pure_osd.h
+++ b/dosbox_pure_osd.h
@@ -2275,4 +2275,157 @@
 static void DBP_CloseOSD()
 {
 	DBP_OSD.SetMode(_DBPOSD_CLOSE);
 }
+
+// SOFIA only receives immutable copies of Pure's native browser state.
+// All access to DBP_OSD and its menu list stays on the emulation thread.
+static std::mutex DBPS_SofiaBrowserMutex;
+static std::vector<DBPS_FileBrowserItem> DBPS_SofiaBrowserItems;
+static std::string DBPS_SofiaBrowserPath;
+static unsigned DBPS_SofiaBrowserRevision = 1;
+static int DBPS_SofiaBrowserSelection = 0;
+static bool DBPS_SofiaBrowserActive = false;
+static std::string DBPS_SofiaBrowserStatus = "Esperando una accion de SOFIA.";
+static bool DBPS_SofiaOpenRequested = false;
+static bool DBPS_SofiaSelectionRequested = false;
+static unsigned DBPS_SofiaRequestedIndex = 0;
+static unsigned DBPS_SofiaRequestedRevision = 0;
+
+static void DBPS_SofiaUpdateBrowserSnapshot()
+{
+	std::vector<DBPS_FileBrowserItem> items;
+	std::string path;
+	int selected = 0;
+	bool active = (DBP_OSD.mode == DBPOSD_MAIN && DBP_OSD.ptr.main &&
+		DBP_OSD.ptr.main->listmode == DBP_PureMenuState::IT_FILEBROWSE);
+	if (active)
+	{
+		path = DBPS_BrowsePath;
+		selected = DBP_OSD.ptr.main->sel;
+		for (const DBP_MenuState::Item& item : DBP_OSD.ptr.main->list)
+		{
+			DBPS_FileBrowserItem copy;
+			copy.type = item.type;
+			copy.info = item.info;
+			copy.text = item.str;
+			items.push_back(copy);
+		}
+	}
+
+	std::lock_guard<std::mutex> lock(DBPS_SofiaBrowserMutex);
+	bool changed = (active != DBPS_SofiaBrowserActive || path != DBPS_SofiaBrowserPath ||
+		items.size() != DBPS_SofiaBrowserItems.size());
+	for (size_t i = 0; !changed && i < items.size(); ++i)
+	{
+		const DBPS_FileBrowserItem& a = items[i];
+		const DBPS_FileBrowserItem& b = DBPS_SofiaBrowserItems[i];
+		changed = (a.type != b.type || a.info != b.info || a.text != b.text);
+	}
+	if (changed)
+	{
+		++DBPS_SofiaBrowserRevision;
+		if (!DBPS_SofiaBrowserRevision) DBPS_SofiaBrowserRevision = 1;
+	}
+	DBPS_SofiaBrowserItems.swap(items);
+	DBPS_SofiaBrowserPath.swap(path);
+	DBPS_SofiaBrowserSelection = selected;
+	DBPS_SofiaBrowserActive = active;
+}
+
+bool DBPS_GetFileBrowserSnapshot(std::vector<DBPS_FileBrowserItem>& items, std::string& path, int& selected, unsigned& revision, std::string& status)
+{
+	std::lock_guard<std::mutex> lock(DBPS_SofiaBrowserMutex);
+	items = DBPS_SofiaBrowserItems;
+	path = DBPS_SofiaBrowserPath;
+	selected = DBPS_SofiaBrowserSelection;
+	revision = DBPS_SofiaBrowserRevision;
+	status = DBPS_SofiaBrowserStatus;
+	return DBPS_SofiaBrowserActive;
+}
+
+void DBPS_RequestFileBrowser()
+{
+	std::lock_guard<std::mutex> lock(DBPS_SofiaBrowserMutex);
+	DBPS_SofiaOpenRequested = true;
+}
+
+void DBPS_RequestFileBrowserSelection(unsigned index, unsigned revision)
+{
+	std::lock_guard<std::mutex> lock(DBPS_SofiaBrowserMutex);
+	if (!DBPS_SofiaSelectionRequested)
+	{
+		DBPS_SofiaRequestedIndex = index;
+		DBPS_SofiaRequestedRevision = revision;
+		DBPS_SofiaBrowserStatus = "Seleccion enviada al puente de Pure.";
+		DBPS_SofiaSelectionRequested = true;
+	}
+}
+
+static void DBPS_UpdateSofiaBrowserBridge()
+{
+	bool open_requested, selection_requested;
+	unsigned requested_index, requested_revision;
+	{
+		std::lock_guard<std::mutex> lock(DBPS_SofiaBrowserMutex);
+		open_requested = DBPS_SofiaOpenRequested;
+		DBPS_SofiaOpenRequested = false;
+		selection_requested = DBPS_SofiaSelectionRequested;
+		requested_index = DBPS_SofiaRequestedIndex;
+		requested_revision = DBPS_SofiaRequestedRevision;
+		DBPS_SofiaSelectionRequested = false;
+	}
+
+	if (open_requested)
+	{
+		if (DBP_OSD.mode != DBPOSD_MAIN || !DBP_OSD.ptr.main)
+			DBP_StartOSD(DBPOSD_MAIN);
+		if (DBP_OSD.mode == DBPOSD_MAIN && DBP_OSD.ptr.main)
+			DBP_OSD.ptr.main->GoToSubMenu(DBP_PureMenuState::IT_FILEBROWSE, DBP_PureMenuState::IT_FILEBROWSE, -1, NULL);
+	}
+
+	if (selection_requested)
+	{
+		DBPS_SofiaUpdateBrowserSnapshot();
+		unsigned current_revision;
+		bool browser_active;
+		{
+			std::lock_guard<std::mutex> lock(DBPS_SofiaBrowserMutex);
+			current_revision = DBPS_SofiaBrowserRevision;
+			browser_active = DBPS_SofiaBrowserActive;
+		}
+		if (browser_active && requested_revision == current_revision &&
+			DBP_OSD.mode == DBPOSD_MAIN && DBP_OSD.ptr.main &&
+			requested_index < DBP_OSD.ptr.main->list.size())
+		{
+			DBP_PureMenuState* menu = DBP_OSD.ptr.main;
+			menu->sel = (int)requested_index;
+			Bit8u item_type = menu->list[requested_index].type;
+			Bit16s item_info = menu->list[requested_index].info;
+			if (item_type != DBP_MenuState::IT_NONE)
+			{
+				{
+					std::lock_guard<std::mutex> lock(DBPS_SofiaBrowserMutex);
+					DBPS_SofiaBrowserStatus = "Ejecutando indice " + std::to_string(requested_index) +
+						", tipo " + std::to_string(item_type) + ", info " + std::to_string(item_info) + ".";
+				}
+				menu->DoInput(DBP_MenuState::RES_OK, item_type, 0);
+				{
+					std::lock_guard<std::mutex> lock(DBPS_SofiaBrowserMutex);
+					DBPS_SofiaBrowserStatus = "Pure proceso la orden. OSD=" +
+						std::to_string((int)DBP_OSD.mode) + ", menu=" +
+						(DBP_OSD.ptr.main ? std::to_string((int)DBP_OSD.ptr.main->listmode) : std::string("sin menu")) + ".";
+				}

+				// Pure returns to its main menu after mounting. Re-enter its browser
+				// at the same path so SOFIA continues to display Pure's own list.
+				if (item_type == DBP_PureMenuState::IT_FILEBROWSE && item_info == 5 &&
+					DBP_OSD.mode == DBPOSD_MAIN && DBP_OSD.ptr.main)
+					DBP_OSD.ptr.main->GoToSubMenu(DBP_PureMenuState::IT_FILEBROWSE, DBP_PureMenuState::IT_FILEBROWSE, -1, NULL);
+			}
+		}
+		else
+		{
+			std::lock_guard<std::mutex> lock(DBPS_SofiaBrowserMutex);
+			DBPS_SofiaBrowserStatus = "Orden rechazada: activo=" + std::to_string(browser_active) +
+				", revision solicitada=" + std::to_string(requested_revision) +
+				", actual=" + std::to_string(current_revision) +
+				", indice=" + std::to_string(requested_index) + ".";
+		}
+	}
+	DBPS_SofiaUpdateBrowserSnapshot();
+}
 
 static void DBP_PureMenuProgram(Program** make)
 {
diff --git a/dosbox_pure_libretro.cpp b/dosbox_pure_libretro.cpp
