diff --git a/src/hardware/sblaster.cpp b/src/hardware/sblaster.cpp
--- a/src/hardware/sblaster.cpp
+++ b/src/hardware/sblaster.cpp
@@ -33,8 +33,24 @@
 #include "support.h"
 #include "shell.h"
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
 #include "emu8k.h"
 #include <stdio.h>
 using namespace std;
 
 extern FILE* DBP_FileOpenContentOrSystem(const char* fname);
+
+static FILE* AWE32_OpenROMBesideExe(void)
+{
+    wchar_t path[MAX_PATH];
+    DWORD length = GetModuleFileNameW(NULL, path, MAX_PATH);
+    if (!length || length >= MAX_PATH) return NULL;
+    wchar_t *slash = wcsrchr(path, L'\\');
+    wchar_t *forward = wcsrchr(path, L'/');
+    if (!slash || (forward && forward > slash)) slash = forward;
+    if (!slash) return NULL;
+    if (wcscpy_s(slash + 1, MAX_PATH - (size_t)(slash + 1 - path), L"awe32.raw")) return NULL;
+    return _wfopen(path, L"rb");
+}
@@ -1743,1 +1759,1 @@
-            FILE *rom = DBP_FileOpenContentOrSystem("awe32.raw");
+            FILE *rom = AWE32_OpenROMBesideExe();
